{
  "name": "@f12o/bpmn-cli",
  "version": "2026.11.1",
  "description": "Command-line BPMN 2.0 authoring, layout, SVG export, and validation tool",
  "author": "f4ah6o",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f4ah6o/bpmn-cli.git"
  },
  "homepage": "https://github.com/f4ah6o/bpmn-cli#readme",
  "bugs": {
    "url": "https://github.com/f4ah6o/bpmn-cli/issues"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "bpmn-moddle",
    "bpmnlint",
    "svg",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bpmn": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/bpmn-cli-workflow.bpmn",
    "docs/bpmn-cli-workflow.svg",
    "skills/bpmn-cli/SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-svg-runtime.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js test/unit/*.test.js test/integration/*.test.js test/svg/*.test.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-js": "18.31.1",
    "bpmn-moddle": "^10.3.1",
    "bpmnlint": "^12.0.0",
    "commander": "^15.0.0",
    "diagram-js": "15.28.1",
    "svgdom": "0.1.29"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.0.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "~5.9.3"
  }
}
