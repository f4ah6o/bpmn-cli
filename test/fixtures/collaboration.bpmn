<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_A" name="Pool A" processRef="Process_A"/>
    <bpmn:participant id="P_B" name="Pool B" processRef="Process_B"/>
    <bpmn:messageFlow id="MF_1" name="Request" sourceRef="startA" targetRef="startB"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_A" name="A" isExecutable="false">
    <bpmn:startEvent id="startA" name="Start A"/>
    <bpmn:task id="taskA" name="Task A"/>
    <bpmn:endEvent id="endA" name="End A"/>
    <bpmn:sequenceFlow id="flowA1" sourceRef="startA" targetRef="taskA"/>
    <bpmn:sequenceFlow id="flowA2" sourceRef="taskA" targetRef="endA"/>
  </bpmn:process>
  <bpmn:process id="Process_B" name="B" isExecutable="false">
    <bpmn:startEvent id="startB" name="Start B"/>
    <bpmn:task id="taskB" name="Task B"/>
    <bpmn:endEvent id="endB" name="End B"/>
    <bpmn:sequenceFlow id="flowB1" sourceRef="startB" targetRef="taskB"/>
    <bpmn:sequenceFlow id="flowB2" sourceRef="taskB" targetRef="endB"/>
  </bpmn:process>
</bpmn:definitions>
