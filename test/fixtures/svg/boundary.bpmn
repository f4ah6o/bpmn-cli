<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" name="Boundary Demo" isExecutable="false">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="work" name="Work">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="timeout" name="Timeout" attachedToRef="work">
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:task id="handler" name="Handler">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="timedOut" name="Timed Out">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="start" targetRef="work" />
    <bpmn:sequenceFlow id="F2" sourceRef="work" targetRef="end" />
    <bpmn:sequenceFlow id="F3" sourceRef="timeout" targetRef="handler" />
    <bpmn:sequenceFlow id="F4" sourceRef="handler" targetRef="timedOut" />
  </bpmn:process>
